# Production values are configured as Sites runtime secrets. Never commit real values.
# Bootstrap shared-login hash: pbkdf2-sha256$100000$base64url-salt$base64url-32-byte-hash
APP_ACCESS_PASSWORD_HASH=
# Independent founder-only hash in the same 100000-iteration PBKDF2 format; required to enable shared-password changes.
APP_FOUNDER_PASSWORD_HASH=
APP_SESSION_SECRET=
APP_CREDENTIAL_ENCRYPTION_KEY=
